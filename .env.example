# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change_me_to_a_random_secret

# URL where better-auth is running (used internally by better-auth)
BETTER_AUTH_URL=http://localhost:3001

# In dev, the Vite proxy forwards /api/* to 3001 from localhost:5173
# In production, all traffic goes through localhost:3001 — FRONTEND_ORIGIN can be omitted
FRONTEND_ORIGIN=http://localhost:5173
