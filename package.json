{
  "name": "pool-tracker",
  "version": "1.0.0",
  "author": "Ishmael Smyrnow",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "bun --watch src/index.ts",
    "dev:web": "vite",
    "dev": "bun run dev:api & bun run dev:web",
    "build": "tsc -p frontend/tsconfig.app.json --noEmit && vite build",
    "start": "NODE_ENV=production bun src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p frontend/tsconfig.app.json --noEmit",
    "lint": "oxlint src/ frontend/src/ e2e/ scripts/",
    "lint:fix": "oxlint --fix src/ frontend/src/ e2e/ scripts/",
    "format": "oxfmt src/ frontend/src/ e2e/ scripts/",
    "format:check": "oxfmt --check src/ frontend/src/ e2e/ scripts/",
    "test": "bun test src/",
    "smoke": "bun scripts/smoke.ts",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@radix-ui/react-slot": "^1.2.5",
    "better-auth": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/bun": "latest",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
